SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=mcmed
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@mcmed.pl

SMS_API_TOKEN=your-smsapi-token
SMS_API_SENDER=McMed

# SMS: log – tylko w konsoli (testy), live – wysyłka przez SMSAPI
SMS_MODE=log

# Fakturownia.pl: live / fake (fikcyjne dokumenty do testów)
FAKTUROWNIA_MODE=fake
FAKTUROWNIA_DOMAIN=twojafirma
FAKTUROWNIA_API_TOKEN=
FAKTUROWNIA_TAX=zw
FAKTUROWNIA_EXEMPT_REASON=
FAKTUROWNIA_PAYMENT_DAYS=7

# Przelewy24: fake (symulacja lokalna, tylko DEBUG) / sandbox / production
P24_MODE=fake
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
# Publiczny adres backendu dla powiadomień P24 (lokalnie: adres z ngrok)
BACKEND_URL=http://localhost:8000
